# Dependencies
node_modules/
**/node_modules/

# Build artifacts (compiled by CI — do not commit)
# admin-pwa/dist/

# Environment files — never commit real credentials
admin-pwa/.env
admin-pwa/.env.local
admin-pwa/.env.*.local
# .env.example is safe to commit

# OS / editor
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
admin-pwa/.vite/
forms/**/.vite/

# tsc transpile output co-located with .tsx source files
forms/**/*.js
forms/**/*.js.map
!forms/**/vite.config.ts
